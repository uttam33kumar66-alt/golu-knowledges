let activeQuiz = [];
let current = 0;
let points = 0;
let answered = false;

function startQuiz(category) {
  if (!quizzes[category] || quizzes[category].length === 0) {
    alert("इस श्रेणी में अभी सवाल उपलब्ध नहीं हैं।");
    return;
  }
  activeQuiz = quizzes[category];
  current = 0;
  points = 0;
  document.getElementById("subjects").style.display = "none";
  document.getElementById("quizArea").style.display = "block";
  document.getElementById("quizArea").scrollIntoView({behavior:"smooth"});
  showQuestion();
}

function showQuestion() {
  answered = false;
  const q = activeQuiz[current];
  document.getElementById("counter").textContent = "सवाल " + (current + 1) + " / " + activeQuiz.length;
  document.getElementById("score").textContent = "स्कोर: " + points;
  document.getElementById("bar").style.width = (current / activeQuiz.length * 100) + "%";
  document.getElementById("question").textContent = (current + 1) + ". " + q[0];
  document.getElementById("feedback").textContent = "";
  const box = document.getElementById("options");
  box.innerHTML = "";
  q[1].forEach((answer, index) => {
    const btn = document.createElement("button");
    btn.className = "option";
    btn.textContent = String.fromCharCode(65 + index) + ". " + answer;
    btn.onclick = () => checkAnswer(index, btn);
    box.appendChild(btn);
  });
  const next = document.getElementById("nextBtn");
  next.disabled = true;
  next.textContent = current === activeQuiz.length - 1 ? "परिणाम देखें ➜" : "अगला सवाल ➜";
}

function checkAnswer(index, btn) {
  if (answered) return;
  answered = true;
  const correct = activeQuiz[current][2];
  const all = document.querySelectorAll("#options .option");
  all.forEach(b => b.disabled = true);
  all[correct].classList.add("correct");
  if (index === correct) {
    points++;
    document.getElementById("feedback").textContent = "✅ बिल्कुल सही जवाब!";
    document.getElementById("feedback").style.color = "#4ade80";
  } else {
    btn.classList.add("wrong");
    document.getElementById("feedback").textContent = "❌ गलत जवाब! सही उत्तर: " + activeQuiz[current][1][correct];
    document.getElementById("feedback").style.color = "#f87171";
  }
  document.getElementById("score").textContent = "स्कोर: " + points;
  document.getElementById("bar").style.width = ((current + 1) / activeQuiz.length * 100) + "%";
  document.getElementById("nextBtn").disabled = false;
}

function nextQuestion() {
  if (!answered) return;
  current++;
  if (current < activeQuiz.length) {
    showQuestion();
  } else {
    document.getElementById("bar").style.width = "100%";
    document.getElementById("counter").textContent = "क्विज पूरा";
    document.getElementById("question").textContent = "🎉 क्विज पूरा हुआ!";
    document.getElementById("options").innerHTML =
      '<div id="result"><h2>आपका परिणाम</h2><p>कुल सवाल: ' + activeQuiz.length +
      '</p><p>सही जवाब: ' + points + '</p><p>गलत जवाब: ' + (activeQuiz.length - points) +
      '</p><h2>' + Math.round(points / activeQuiz.length * 100) + '% अंक</h2></div>';
    document.getElementById("feedback").textContent = "शाबाश! अभ्यास करते रहें।";
    document.getElementById("feedback").style.color = "#facc15";
    document.getElementById("nextBtn").disabled = true;
    document.getElementById("nextBtn").textContent = "क्विज पूरा हुआ";
  }
}

function goHome() {
  document.getElementById("quizArea").style.display = "none";
  document.getElementById("subjects").style.display = "block";
  document.getElementById("subjects").scrollIntoView({behavior:"smooth"});
}
